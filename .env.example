# Copia este archivo a .env (no subas .env a Git).
# COCKROACH_URL lo encuentras en la consola de CockroachDB:
#   latambanks-25604.j77.aws-us-east-1.cockroachlabs.cloud → Connect → psycopg2 URL
COCKROACH_URL=postgresql://user:password@latambanks-25604.j77.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=require

# Clave del usuario master para publicar calificaciones de riesgo desde
# Config › Credit ratings. Sin ella el endpoint de escritura rechaza todo.
# En producción se define en Vercel, no acá. Ver HANDOFF_Ratings_ClaveEscritura.md
RATINGS_WRITE_KEY=
